{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "识办",
  "version": "1.5.0",
  "identifier": "com.shiban.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:14720",
    "beforeDevCommand": "python3 -m http.server 14720 --bind 127.0.0.1 --directory ui",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "识办",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
