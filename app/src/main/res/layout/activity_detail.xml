<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/back"
            style="@style/ShibanBack"
            android:text="返回" />

        <TextView
            style="@style/ShibanTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="待办详情" />

        <View
            android:layout_width="52dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ShibanLabel"
                    android:layout_marginTop="0dp"
                    android:text="待办内容" />

                <android.widget.EditText
                    android:id="@+id/content"
                    style="@style/Widget.Shiban.Field"
                    android:gravity="top|start"
                    android:hint="写下要做的事情…"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Card 2: Time & Reminder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ShibanLabel"
                    android:layout_marginTop="0dp"
                    android:text="提醒时间" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/timeButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:drawableStart="@drawable/ic_clock"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="选择时间"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/timeClear"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="4dp"
                        android:text="清除"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/timeQuick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/timeOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/warning"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Card 3: Location, Importance & Necessity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ShibanLabel"
                    android:layout_marginTop="0dp"
                    android:text="地点" />

                <android.widget.EditText
                    android:id="@+id/location"
                    style="@style/Widget.Shiban.Field"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="10dp"
                    android:hint="可留空，如：会议室、办公室"
                    android:inputType="text" />

                <TextView
                    style="@style/ShibanLabel"
                    android:layout_marginTop="16dp"
                    android:text="重要性 · 影响程度" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/importance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/impHigh"
                        style="@style/Widget.Shiban.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="高" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/impMedium"
                        style="@style/Widget.Shiban.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="中" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/impLow"
                        style="@style/Widget.Shiban.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="低" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/ShibanLabel"
                    android:layout_marginTop="16dp"
                    android:text="必要性 · 是否必做" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/necessity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/necMust"
                        style="@style/Widget.Shiban.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="必须" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/necShould"
                        style="@style/Widget.Shiban.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="应该" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/necOptional"
                        style="@style/Widget.Shiban.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="可选" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/ShibanLabel"
                    android:layout_marginTop="16dp"
                    android:text="备注说明" />

                <android.widget.EditText
                    android:id="@+id/note"
                    style="@style/Widget.Shiban.Field"
                    android:gravity="top|start"
                    android:hint="可添加更多细节或备注…"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Card 4: Image Attachments -->
            <HorizontalScrollView
                android:id="@+id/imageScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/imageRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Card 5: Source Text (if any) -->
            <TextView
                android:id="@+id/sourceLabel"
                style="@style/ShibanSection"
                android:layout_marginTop="16dp"
                android:text="原始分享来源"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sourceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/reparse"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:text="重新识别"
                android:textColor="@color/seal"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/created"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dock"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/complete"
                style="@style/Widget.Shiban.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="标记完成" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save"
                style="@style/Widget.Shiban.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存修改" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete"
            style="@style/Widget.Shiban.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="删除这条待办"
            android:textColor="@color/danger" />
    </LinearLayout>
</LinearLayout>
