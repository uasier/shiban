<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/index"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="事项 1"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/remove"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:text="移除"
            android:textColor="@color/seal"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        style="@style/ShibanLabel"
        android:layout_marginTop="12dp"
        android:text="内容" />

    <android.widget.EditText
        android:id="@+id/content"
        style="@style/Widget.Shiban.Field"
        android:gravity="top|start"
        android:hint="要做的事"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2" />

    <TextView
        style="@style/ShibanLabel"
        android:text="时间" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/timeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="选择时间"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/timeClear"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:text="清除"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/timeQuick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/timeOriginal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/gold"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        style="@style/ShibanLabel"
        android:text="地点" />

    <android.widget.EditText
        android:id="@+id/location"
        style="@style/Widget.Shiban.Field"
        android:hint="可空"
        android:inputType="text" />

    <TextView
        style="@style/ShibanLabel"
        android:text="重要性 · 影响大不大" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/importance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/impHigh"
            style="@style/Widget.Shiban.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="高" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/impMedium"
            style="@style/Widget.Shiban.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="中" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/impLow"
            style="@style/Widget.Shiban.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="低" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        style="@style/ShibanLabel"
        android:text="必要性 · 不做行不行" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/necessity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/necMust"
            style="@style/Widget.Shiban.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="必须" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/necShould"
            style="@style/Widget.Shiban.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="应该" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/necOptional"
            style="@style/Widget.Shiban.Toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="可选" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        style="@style/ShibanLabel"
        android:text="备注" />

    <android.widget.EditText
        android:id="@+id/note"
        style="@style/Widget.Shiban.Field"
        android:gravity="top|start"
        android:hint="判断依据，可改"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:textSize="14sp" />
</LinearLayout>
